# Cloud provider API keys (optional — only needed if allow_cloud = true)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# AZURE_OPENAI_API_KEY=...

# --- Logging ---
# Logging
# MOBISCOPE_LOG_LEVEL=info

# Enable bearer-token auth on /api/* (required before exposing ports
# beyond loopback). See SECURITY.md.
# MOBISCOPE_API_TOKEN=

# Ollama endpoint. Inside docker compose this defaults to http://ollama:11434.
# OLLAMA_HOST=http://localhost:11434

# Path to a TOML config file (optional; overrides discovery).
# MOBISCOPE_CONFIG=/path/to/config.toml

# Generic config overrides use MOBISCOPE_ with "__" as the key separator:
# MOBISCOPE_LLM__ALLOW_CLOUD=true
# MOBISCOPE_LLM__PROVIDERS__OLLAMA__BASE_URL=http://127.0.0.1:11434
